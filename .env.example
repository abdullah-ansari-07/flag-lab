# REQUIRED. Server-side secret ("pepper") used to HMAC flags. At least 32 chars.
# Generate with `npm run init-env` (creates .env for you) or `openssl rand -hex 32`.
# Never commit the real value.
FLAG_PEPPER=change-me-generate-a-long-random-secret-at-least-32-chars

PORT=3000
SESSION_TTL_MINUTES=60

# Optional: enables GET /api/admin/attempts (audit trail). Leave empty to disable.
ADMIN_TOKEN=

# Demo mode adds a "Reveal flags" button to the UI so you can show that labs differ.
# It exposes plaintext flags through the API, so keep it false for real learners.
DEMO_MODE=false

# Login cookie lifetime, and set COOKIE_SECURE=true when serving over HTTPS.
LOGIN_TTL_HOURS=8
COOKIE_SECURE=false

# 'docker' (real containers) or 'mock' (in-memory, for machines without Docker)
DOCKER_DRIVER=docker
TARGET_IMAGE=flag-lab-target:latest
MAX_ACTIVE_SESSIONS=50
SWEEP_INTERVAL_SECONDS=30
# DB_PATH=./data/flags.db
